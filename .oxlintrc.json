{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "supabase/functions/**"
      ],
      "globals": {
        "Deno": "readonly"
      }
    },
    {
      "files": [
        "*.mjs",
        "vite.config.js",
        "src/__tests__/**"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
